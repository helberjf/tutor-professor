# =============================================================================
# Deploy variables for docker-compose.prod.yml (the VPS running the backend).
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# .env.prod holds secrets and is gitignored — never commit the filled-in copy.
# These values configure the stack itself; application settings that are not
# secrets live in apps/api/.env (copy it from apps/api/.env.example).
# =============================================================================

# -----------------------------------------------------------------------------
# [REQUIRED] Domain that points to this VPS, e.g. api.seudominio.com
# Create an A record for it pointing at the server's public IP *before* starting
# the stack, otherwise Caddy cannot complete the certificate challenge.
# -----------------------------------------------------------------------------
API_DOMAIN=api.exemplo.com

# -----------------------------------------------------------------------------
# [REQUIRED] Address Let's Encrypt uses for expiry warnings.
# -----------------------------------------------------------------------------
ACME_EMAIL=voce@exemplo.com

# -----------------------------------------------------------------------------
# [REQUIRED] Signs session tokens AND derives the key that encrypts each user's
# stored AI API key. The API refuses to boot with a placeholder. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it later logs everyone out and makes already-stored AI keys
# undecryptable, so set it once and keep a backup.
# -----------------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------------
# [REQUIRED] The administrator account. Whoever signs up waits in a queue and
# only reaches the app once the account with this e-mail approves them at
# /admin. Create the account itself on the server with:
#   python scripts/create-admin-user.py --email admin@yourdomain.com
# That script also prints ADMIN_PASSWORD_HASH, an optional recovery password
# that lets the administrator sign in even if the stored one is lost.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# [REQUIRED] Postgres password. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Only read on first start, when the database cluster is created.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# [REQUIRED] Origins allowed to call this API, comma separated and without a
# trailing slash. Include every frontend domain — a missing one shows up as a
# CORS error in the browser, not as a server error.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://tutorprofessor.vercel.app

# -----------------------------------------------------------------------------
# [OPTIONAL] Where the Google OAuth flow sends the user back to. Only matters if
# you enabled Google login. Defaults to the Vercel domain.
# -----------------------------------------------------------------------------
FRONTEND_BASE_URL=https://tutorprofessor.vercel.app

# -----------------------------------------------------------------------------
# [OPTIONAL] Defaults are fine; change only for an existing database.
# -----------------------------------------------------------------------------
POSTGRES_DB=kids_tutor
POSTGRES_USER=kids_tutor

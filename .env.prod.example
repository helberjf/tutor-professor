# =============================================================================
# Deploy variables for docker-compose.prod.yml (the VPS running the backend).
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# .env.prod holds secrets and is gitignored — never commit the filled-in copy.
# These values configure the stack itself; application settings that are not
# secrets live in apps/api/.env (copy it from apps/api/.env.example).
# =============================================================================

# -----------------------------------------------------------------------------
# [REQUIRED] Domain that points to this VPS, e.g. api.seudominio.com
# Create an A record for it pointing at the server's public IP *before* starting
# the stack, otherwise Caddy cannot complete the certificate challenge.
# -----------------------------------------------------------------------------
API_DOMAIN=api.exemplo.com

# -----------------------------------------------------------------------------
# [REQUIRED] Address Let's Encrypt uses for expiry warnings.
# -----------------------------------------------------------------------------
ACME_EMAIL=voce@exemplo.com

# -----------------------------------------------------------------------------
# [REQUIRED] Signs session tokens AND derives the key that encrypts each user's
# stored AI API key. The API refuses to boot with a placeholder. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it logs everyone out. It no longer destroys stored AI keys — those
# have their own key now, AI_ENCRYPTION_KEY below — but rows written before that
# split still need this value to be read, so keep a backup either way.
# -----------------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------------
# [REQUIRED] The administrator account. Whoever signs up waits in a queue and
# only reaches the app once the account with this e-mail approves them at
# /admin. Create the account itself on the server with:
#   python scripts/create-admin-user.py --email admin@yourdomain.com
# That script also prints ADMIN_PASSWORD_HASH, an optional recovery password
# that lets the administrator sign in even if the stored one is lost.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# [REQUIRED] Postgres password. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Only read on first start, when the database cluster is created.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# [REQUIRED] Origins allowed to call this API, comma separated and without a
# trailing slash. Include every frontend domain — a missing one shows up as a
# CORS error in the browser, not as a server error.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://tutorprofessor.vercel.app

# -----------------------------------------------------------------------------
# [OPTIONAL] Where the Google OAuth flow sends the user back to. Only matters if
# you enabled Google login. Defaults to the Vercel domain.
# -----------------------------------------------------------------------------
FRONTEND_BASE_URL=https://tutorprofessor.vercel.app

# -----------------------------------------------------------------------------
# [OPTIONAL] Defaults are fine; change only for an existing database.
# -----------------------------------------------------------------------------
POSTGRES_DB=kids_tutor
POSTGRES_USER=kids_tutor

# -----------------------------------------------------------------------------
# [STRONGLY RECOMMENDED] Encrypts the AI API keys accounts store. Separate from
# SESSION_SECRET so a session secret can be rotated after a scare without making
# every saved key unreadable. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# While rotating, put the previous value in AI_ENCRYPTION_KEYS_OLD (comma
# separated): the new key encrypts and every listed key still decrypts.
# -----------------------------------------------------------------------------
AI_ENCRYPTION_KEY=
AI_ENCRYPTION_KEYS_OLD=

# -----------------------------------------------------------------------------
# [OPTIONAL] How a new account gets in.
#   manual (default) — every signup waits in the administrator's queue at /admin
#   open             — a verified e-mail address is enough
# Open signup needs a working EMAIL_PROVIDER below, or nobody can verify.
# -----------------------------------------------------------------------------
SIGNUP_MODE=manual

# -----------------------------------------------------------------------------
# [OPTIONAL] Leave OFF in any hosted deployment. On, a request with no session
# falls back to one shared child profile — convenient for a single family on a
# laptop, a data leak for anything on the internet.
# -----------------------------------------------------------------------------
ALLOW_GUEST_ACCESS=false

# -----------------------------------------------------------------------------
# [RECOMMENDED] Transactional e-mail: verification, password reset, notices.
# With provider "console" the messages are only written to the log, which means
# nobody can reset a password. Set a real SMTP server before opening signup.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# [RECOMMENDED] Behind Caddy the socket address is the proxy, so rate limiting
# needs the forwarded header to see the real client. Only turn this on when a
# proxy really is in front: without one, anyone can set the header themselves.
# -----------------------------------------------------------------------------
TRUST_PROXY_HEADERS=true

# -----------------------------------------------------------------------------
# [OPTIONAL] Rate limits. Signups and logins per address, AI generations per
# account. Note these are per uvicorn worker (see services/rate_limit.py).
# -----------------------------------------------------------------------------
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=900
AI_RATE_LIMIT=60
AI_RATE_WINDOW_SECONDS=3600

# -----------------------------------------------------------------------------
# [OPTIONAL] Billing. With provider "none" the plans and their limits still
# apply and trials still start; only paid checkout is unavailable. The webhook
# secret signs incoming gateway events and must be set before the webhook will
# accept anything.
# -----------------------------------------------------------------------------
BILLING_PROVIDER=none
BILLING_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# [OPTIONAL] Estimated cost of one AI generation on the platform key, in
# millionths of a currency unit. Feeds the per-account monthly cost. 3000 = R$
# 0,003. Correct it once you have a real invoice to compare against.
# -----------------------------------------------------------------------------
AI_GENERATION_COST_MICROS=3000

# -----------------------------------------------------------------------------
# [OPTIONAL] Logging. json emits one object per line for a log shipper; text is
# for reading in a terminal. A request slower than SLOW_REQUEST_MS is logged as
# a warning.
# -----------------------------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO
SLOW_REQUEST_MS=2000

# -----------------------------------------------------------------------------
# [OPTIONAL] Hosting shape. The defaults are what a long-running server (this
# compose file, or a laptop) already did; only a serverless host changes them.
# See docs/deploy-vercel-supabase.md.
#
#   RUN_STARTUP_MIGRATIONS  on by default. Off means the schema is applied out of
#                           band, with: cd apps/api && DATABASE_URL="<direct>"
#                           python database_bootstrap.py
#   DB_POOL_MODE            "queue" (default, a small pool) or "null" (a fresh
#                           connection per checkout). Only change it if a shared
#                           pooler runs out of slots.
#   CONTENT_DIR             overrides where seed content lives. Unset is correct.
# -----------------------------------------------------------------------------
RUN_STARTUP_MIGRATIONS=true
DB_POOL_MODE=queue

# -----------------------------------------------------------------------------
# [OPTIONAL] How much work one request may take on. A host that cuts requests off
# needs these smaller; a server with no limit can leave them alone.
# -----------------------------------------------------------------------------
MAX_LESSONS_PER_REQUEST=10
REQUEST_TIME_BUDGET_SECONDS=600
BOOK_GENERATION_MAX_RETRIES=3
GEMINI_REQUEST_TIMEOUT_SECONDS=45

# -----------------------------------------------------------------------------
# [OPTIONAL] Shared audio cache. All three or none: a half-configured store would
# silently swallow audio. With them unset the local directory is used, which is
# correct for a server that owns its disk.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUDIO_BUCKET=

# -----------------------------------------------------------------------------
# [OPTIONAL] Kokoro reached over a tunnel rather than on localhost.
#
# KOKORO_URL fixed  -> used directly, nothing else needed (a named tunnel).
# KOKORO_URL empty  -> the address is read from a config row that the tunnel host
#                      publishes with scripts/publish-kokoro-url.ps1, guarded by
#                      RUNTIME_SYNC_TOKEN.
#
# KOKORO_AUTH_TOKEN is sent as X-Kokoro-Token and must match KOKORO_PROXY_TOKEN in
# scripts/kokoro_auth_proxy.py. Exposing Kokoro through a tunnel without that
# proxy leaves it open to anyone who learns the hostname.
# -----------------------------------------------------------------------------
KOKORO_URL=
KOKORO_AUTH_TOKEN=
KOKORO_URL_CACHE_TTL_SECONDS=60
RUNTIME_SYNC_TOKEN=
